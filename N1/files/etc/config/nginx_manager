config global 'global'
	option managed_dir '/etc/nginx/conf.d/luci-manager'
	option cert_dir '/etc/nginx/certs/luci-manager'
	option backup_dir '/etc/nginx-manager/backups'
	option auto_backup '1'
	option test_before_reload '1'
	option advanced_mode '0'
	option dangerous_core_edit '0'
	option max_backups '10'
	option client_max_body_size '10g'
	option keepalive_timeout '65'
	option gzip '1'
	option server_tokens 'off'
	option sendfile '1'
	option ssl_session_cache 'shared:SSL:10m'
	option ssl_session_tickets '0'
	option ssl_session_timeout '10m'
	option http2 '1'
	option http3 '0'
	option security_headers '1'
